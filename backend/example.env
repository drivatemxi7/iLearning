# Copy this file to .env and replace every placeholder before running.
# For Docker Compose, DB_HOST must be "db". For local NestJS outside Docker, use "localhost".
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=lmdrp
POSTGRES_USER=lmdrp_user
POSTGRES_PASSWORD=change_this_database_password

DATABASE_URL="postgresql://lmdrp_user:change_this_database_password@db:5432/lmdrp?schema=public"

JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
